PORT=8000
HOST=127.0.0.1
ENVIRONMENT=production

# User-Provided Groq API Key (Ultra-Fast LLaMA 3.3 70B)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# User-Provided Google Gemini Key (Gemini 1.5 Flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# AI 4 Bharat Indic Language API
AI4BHARAT_USER_ID=
AI4BHARAT_API_KEY=
AI4BHARAT_PIPELINE_ENDPOINT=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline

# Hugging Face Inference API for Disease Detection
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Arko007/skin-disease-detector-ai
MONGODB_URI=mongodb://localhost:27017/swasya_ai
